DATABASE_URL=postgres://scoat_owner:REPLACE_WITH_PASSWORD@db.example.invalid:5432/scoat
PORT=443
SCOAT_LISTEN_HOST=127.0.0.1
SCOAT_AUTH_CONFIG=/etc/scoat/auth.json
SCOAT_CONTROL_CONFIG=/etc/scoat/control.json
SCOAT_WATCH_CONFIG=/etc/scoat/watch.json
SCOAT_TLS_KEY=/etc/scoat/tls/key.pem
SCOAT_TLS_CERT=/etc/scoat/tls/cert.pem
SCOAT_PG_BIN=/usr/lib/postgresql/18/bin
