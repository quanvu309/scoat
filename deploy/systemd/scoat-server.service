[Unit]
Description=Scoat HTTPS MCP and browser server
Documentation=file:///opt/scoat/release/docs/operations.md
Requires=scoat-migrate.service
After=scoat-migrate.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scoat
Group=scoat
WorkingDirectory=/opt/scoat/release
EnvironmentFile=/etc/scoat/scoat.env
ExecStart=/usr/bin/node /opt/scoat/release/dist/server.js
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
