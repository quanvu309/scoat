{
  "name": "@scoat/server",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:comments": "node scripts/check-no-comments.mjs",
    "build": "tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "test": "node --test test/*.test.mjs test/*.test.ts",
    "verify": "node scripts/verify.mjs",
    "perf": "node scripts/perf.mjs",
    "lint": "npm run lint:comments && node scripts/check-structure.mjs",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "start:worker": "node scripts/worker.mjs",
    "accounts:maintain": "node scripts/maintain-accounts.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "drizzle-orm": "0.45.4",
    "oidc-provider": "9.13.3",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@types/node": "26.6.6",
    "@types/oidc-provider": "9.13.1",
    "@types/pg": "8.23.1",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
